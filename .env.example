# ============================================================
# LearnSync AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Gemini / Google AI API Key ---
# Used by Member 2 (rag.py) to generate LLM explanations.
# If not set, the system automatically falls back to the
# deterministic offline synthesizer (no API required).
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- PostgreSQL Database URL (Optional) ---
# Format: postgresql://user:password@host:port/dbname
# If not set, LearnSync AI automatically uses a local SQLite
# database (learnsync.db) for development and demonstration.
# For production / deployment, configure a real PostgreSQL URL.
DATABASE_URL=

# --- Streamlit Configuration (Optional) ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=false
